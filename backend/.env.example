# Application
APP_NAME="Regal Foundation API"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=regal_foundation

# Payment Gateways (replace with real keys)
PAYSTACK_SECRET_KEY=your_paystack_test_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_test_public_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@regalfoundation.org
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@regalfoundation.org
SMTP_FROM_NAME="Regal Foundation"

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin

# Media
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
